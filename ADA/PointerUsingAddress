#include <iostream>
using namespace std;

int main() {
    int num = 25;
    
    int *ptr = &num;

    cout << "Value of num: " << num << endl;
    cout << "Address of num: " << &num << endl;
    cout << "Value of ptr (address stored): " << ptr << endl;
    cout << "Value at address stored in ptr: " << *ptr << endl;

    return 0;
}
